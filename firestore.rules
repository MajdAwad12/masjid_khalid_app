rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep the existing admin profile as a second source of truth during
    // migration. Only Cloud Functions may create/update admin profiles.
    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isAdmin() && validExpiration();
      allow delete: if isAdmin();

      function validExpiration() {
        return !('expiresAt' in request.resource.data)
          || request.resource.data.expiresAt == null
          || request.resource.data.expiresAt is timestamp;
      }
    }

    // Public home card; only authenticated admins may change it.
    // Never allow clients to write arbitrary app settings.
    match /app_settings/{settingId} {
      allow get: if settingId == 'home';
      allow list: if false;
      allow create, update: if settingId == 'home'
        && isAdmin()
        && validHomeCard();
      allow delete: if false;

      function validHomeCard() {
        return request.resource.data.keys().hasOnly([
            'visible', 'title', 'content', 'source', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll([
            'visible', 'title', 'content', 'source', 'updatedAt', 'updatedBy'])
          && request.resource.data.visible is bool
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1500
          && request.resource.data.source is string
          && request.resource.data.source.size() <= 200
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Public signup and any client-side profile/role modifications are disabled.
      // Firebase Admin SDK in Cloud Functions bypasses client rules.
      allow create, update, delete: if false;
    }

    // Existing admin cooldown metadata remains server-owned.
    match /security_password_reset_limits/{uid} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Other collections are inaccessible to clients unless explicitly granted.
  }
}
